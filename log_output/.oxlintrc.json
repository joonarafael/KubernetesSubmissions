{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    "nursery": "error"
  },
  "rules": {
    "func-style": "off",
    "no-console": ["error", { "allow": ["log"] }],
    "one-var": "off",
    "sort-vars": "off"
  },
  "env": {
    "builtin": true,
    "node": true
  }
}
